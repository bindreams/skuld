{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "7 days",
  "platformAutomerge": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Release toolchain pin (see CONTRIBUTING.md, Toolchain pin)",
      "managerFilePatterns": ["/^\\.github/release-toolchain$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "description": "Group Cargo updates",
      "matchManagers": ["cargo"],
      "groupName": "cargo",
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    },
    {
      "description": "Group pip updates",
      "matchManagers": ["pep621"],
      "groupName": "pip",
      "automerge": true,
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"]
    }
  ]
}
